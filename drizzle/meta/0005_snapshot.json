          "value": "\"invoice\".\"status\" not in ('sent', 'paid') or (\"invoice\".\"number\" is not null and \"invoice\".\"client_id\" is not null and \"invoice\".\"client_snapshot\" is not null and \"invoice\".\"sent_at\" is not null and \"invoice\".\"total_cents\" > 0)"
