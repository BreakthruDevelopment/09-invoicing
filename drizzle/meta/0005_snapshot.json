          "name": "invoice_paid_chk",
          "value": "(\"invoice\".\"status\" = 'paid') = (\"invoice\".\"paid_at\" is not null) and (\"invoice\".\"status\" <> 'paid' or \"invoice\".\"paid_cents\" = \"invoice\".\"total_cents\")"
        },
