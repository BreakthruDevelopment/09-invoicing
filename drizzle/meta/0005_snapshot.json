          "value": "\"invoice\".\"subtotal_cents\" >= 0 and \"invoice\".\"tax_cents\" >= 0 and \"invoice\".\"total_cents\" = \"invoice\".\"subtotal_cents\" + \"invoice\".\"tax_cents\" and \"invoice\".\"paid_cents\" between 0 and \"invoice\".\"total_cents\""
